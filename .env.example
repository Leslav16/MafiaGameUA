# Copy this file to .env and change the secret.

# LiveKit API key and secret ("key: secret"). The secret must be at least 32 characters.
LIVEKIT_KEYS=mafia: change-me-to-a-long-random-secret-of-32-plus-chars

# The IP address other devices use to reach this computer.
# For testing on your home Wi-Fi, use this computer's local IP (ipconfig -> IPv4 Address), e.g. 192.168.1.20.
LIVEKIT_NODE_IP=127.0.0.1
