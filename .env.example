# Copy this file to .env and change the secret.

# LiveKit API key and secret ("key: secret"). The secret must be at least 32 characters.
LIVEKIT_KEYS=mafia: change-me-to-a-long-random-secret-of-32-plus-chars

# The IP address other devices use to reach this computer.
# For testing on your home Wi-Fi, use this computer's local IP (ipconfig -> IPv4 Address), e.g. 192.168.1.20.
# start-online.bat fills in your internet address by itself, so leave this as it is for online games.
LIVEKIT_NODE_IP=127.0.0.1

# --- Only for LiveKit Cloud (video through LiveKit's servers instead of this computer) ---
# Fill in both, and put the Cloud project's "API key: API secret" in LIVEKIT_KEYS above.
# Leave both empty to keep the video on this computer.
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud

# --- Only if the free links (Cloudflare, localhost.run, serveo, pinggy) don't work from your network ---
# Free ngrok account (dashboard.ngrok.com) -> "Your Authtoken". start-online.bat then uses ngrok first.
# NGROK_AUTHTOKEN=
# Optional: your free permanent ngrok address (dashboard.ngrok.com -> Domains), so the link is the same every time.
# NGROK_DOMAIN=your-words.ngrok-free.app

# --- Only with a static ("white") IP and your own https domain pointing at this computer ---
# Skips every tunnel; friends open this address directly.
# PUBLIC_URL=https://your-domain.example
